# ==============================================================================
# PT ANUGRAH KEMASAN KREATIF (AKK) - HOSTINGER PRODUCTION ENV
# ==============================================================================
# File ini hanya template nama variabel. Jangan isi secret production ke GitHub.
# Nilai sebenarnya disimpan di Hostinger -> Website -> Environment Variables.
# Jangan gunakan prefix VITE_ untuk password, secret, atau API key.
# ==============================================================================

NODE_ENV=production
APP_URL=https://akkoperasional.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u649808503_ops_node
DB_USER=u649808503_ops_node
DB_PASSWORD=

# Minimal 32 karakter acak; digunakan untuk HttpOnly session cookie.
SESSION_SECRET=

# Opsional. Hapus dari Hostinger jika fitur Gemini tidak dipakai.
GEMINI_API_KEY=
