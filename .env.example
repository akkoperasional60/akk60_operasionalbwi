# ==============================================================================
# PT ANUGRAH KEMASAN KREATIF (AKK) - HOSTINGER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin berkas ini menjadi '.env' untuk pengembangan lokal atau konfigurasikan
# di Website Dashboard -> Environment Variables pada Hostinger Node.js Web App Anda.
# PENTING: JANGAN PERNAH menyertakan API Key atau Kredensial Rahasia asli ke GitHub!
# ==============================================================================

NODE_ENV=production

# 1. APPLICATION HOSTING URL (Domain Resmi Hostinger)
APP_URL="https://honeydew-capybara-825103.hostingersite.com"

# 2. HOSTINGER MYSQL DATABASE CONFIGURATION (Server-Side Secret Variables)
# Otomatis menggunakan port 3306 & localhost (127.0.0.1) pada Hostinger Node.js Web App
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="u194997008_akk_operasional"
DB_USER="u194997008_akk_app"
DB_PASSWORD="MASUKKAN_PASSWORD_DATABASE_DI_HOSTINGER_DASHBOARD"

# 3. TRACKSOLID GPS TELEMATICS API (Server-Side Secret Variables)
# Kredensial tidak pernah dikirim ke browser; diakses aman via Express proxy (/api/tracksolid/*)
TRACKSOLID_ACCOUNT="nstrargo"
TRACKSOLID_PASSWORD="MASUKKAN_PASSWORD_TRACKSOLID_DI_HOSTINGER_DASHBOARD"

# 4. WHATSAPP GATEWAY (Notifikasi Otomatis Pengemudi - Server-Side Secret)
WHATSAPP_API_KEY=""

# 5. GOOGLE GEMINI AI API (Server-Side Chat Assistant)
GEMINI_API_KEY=""
