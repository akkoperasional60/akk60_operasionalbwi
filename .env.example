# ==============================================================================
# PT ANUGRAH KEMASAN KREATIF (AKK) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin berkas ini menjadi '.env' untuk pengembangan lokal atau konfigurasikan
# di menu Settings -> Environment Variables pada dashboard Vercel Anda.
# PENTING: JANGAN PERNAH menyertakan API Key atau kredensial rahasia asli ke GitHub!
# ==============================================================================

# 1. GOOGLE GEMINI AI API (Server-Side Chat Assistant)
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. APPLICATION HOSTING URL
# Diisi dengan domain resmi Vercel Anda (misal: https://akk-logistics.vercel.app)
APP_URL="http://localhost:3000"

# 3. SUPABASE DATABASE (Opsional untuk integrasi PostgreSQL & Auth)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# 4. TRACKSOLID GPS API (Opsional)
VITE_TRACKSOLID_ACCOUNT=""
VITE_TRACKSOLID_PASSWORD=""

# 5. WHATSAPP GATEWAY (Opsional untuk notifikasi otomatis pengemudi)
WHATSAPP_API_KEY=""
