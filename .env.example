# ==============================================================================
# PT ANUGRAH KEMASAN KREATIF (AKK) - HOSTINGER WEB ENVIRONMENT CONFIGURATION
# ==============================================================================
# Gunakan sebagai daftar nama ENV untuk website Node.js di Hostinger.
# Nilai rahasia diisi langsung di Hostinger Website Dashboard -> Environment Variables.
# JANGAN commit file .env berisi secret ke GitHub.
# PENTING: JANGAN pernah memakai prefix VITE_ untuk password, secret, atau API key!
# ==============================================================================

NODE_ENV=production
APP_URL=https://akkoperasional.com

# Hostinger MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u649808503_operasional
DB_USER=u649808503_operasional
DB_PASSWORD=Akkoperasional60.

# Secret sesi login server (HttpOnly cookie), WAJIB minimal 32 karakter acak di production
SESSION_SECRET=kunciRahasiaOperasionalAkk2026SangatAmanSekali123

# Hanya untuk membuat Super Admin pertama pada database baru.
# Setelah Super Admin berhasil dibuat dan login pertama berhasil:
# HAPUS BOOTSTRAP_ADMIN_PASSWORD dari Hostinger ENV!
# BOOTSTRAP_ADMIN_EMAIL dan BOOTSTRAP_ADMIN_NAME juga boleh dihapus setelah bootstrap selesai.
BOOTSTRAP_ADMIN_EMAIL= akkoperasional60@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Super Admin

# Integrasi API Server-Side
WHATSAPP_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# CATATAN KEAMANAN WEB HOSTINGER:
# JANGAN taruh variabel build APK Android berikut di Environment Variables web Hostinger:
# - APK_KEYSTORE_PASSWORD
# - APK_KEY_PASSWORD
# - APK_KEY_ALIAS
# - APK_PORTAL_URL
# - APK_FALLBACK_PORTAL_URL
# Kelima variabel APK_* tersebut khusus proses build APK lokal/CI, bukan runtime website.
# ==============================================================================
